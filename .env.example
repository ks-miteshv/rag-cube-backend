# Node.js Environment Configuration
NODE_ENV=development  # Options: production, development, test

# Database Connection Configuration
# PostgreSQL Connection
CUBEJS_DB_TYPE=       # Example: localhost, postgres, mysql, cubestore
CUBEJS_DB_HOST=       # Example: db.example.com
CUBEJS_DB_PORT=       # Default PostgreSQL port is 5432
CUBEJS_DB_NAME=       # Example: analytics_db
CUBEJS_DB_USER=       # Example: db_user
CUBEJS_DB_PASS=       # Example: use a strong password in production

# API and Security Settings
CUBEJS_API_SECRET=your-custom-string  # 32-character API secret key

# Application Behavior Settings
CUBEJS_DEV_MODE=true   # Set to true for development mode, false for production
CUBEJS_EXTERNAL_DEFAULT=true
CUBEJS_SCHEDULED_REFRESH_DEFAULT=true

# File System Configuration
CUBEJS_SCHEMA_PATH=model

# Set to true so a Cube instance acts as a refresh worker
CUBEJS_REFRESH_WORKER=true